---
const resources = [
  {
    title: "Henry Santana: Why We Need to End Parking Minimums",
    description:
      "A deep dive on how parking requirements impact the housing crisis in Boston.",
    type: "article",
    url: "https://mailchi.mp/boston/2025-12-parking-minimums/",
    iconPath: "M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    title: "Vox: The High Cost of Free Parking",
    description:
      "A video breaking down the impact free parking has on cities and the research of Donald Shoup.",
    type: "video",
    url: "https://www.youtube.com/watch?v=Akm7ik-H_7U",
    iconPath:
      "M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    title: "Planetizen: Parking Reform Can Boost Homebuilding 40 to 70 Percent",
    description:
      "An article examining the evidence that parking flexibility is key to housing abundance.",
    type: "article",
    url: "https://www.planetizen.com/news/2024/12/133177-parking-reform-can-boost-homebuilding-40-70-percent",
    iconPath: "M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    title:
      "Sightline Institute: Parking Reform Legalized Most of the New Homes in Buffalo and Seattle",
    description:
      "A case study on how changing parking policies led to increased housing development in two U.S. cities.",
    type: "article",
    url: "https://www.sightline.org/2023/04/13/parking-reform-legalized-most-of-the-new-homes-in-buffalo-and-seattle",
    iconPath: "M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  },
];
---

<section id="problem" class="bg-white">
  <div class="container mx-auto py-16 md:py-24 px-4">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">
      How Outdated Parking Rules Hurt Our City
    </h2>

    <p class="text-gray-600 text-center max-w-3xl mx-auto mb-12">
      Mandatory parking minimums are hidden rules that force developers to build
      expensive parking, whether it's needed or not. This has real costs for
      everyone.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 text-center">
      <!-- Feature 1 -->
      <div class="flex-1 bg-gray-50 p-8 rounded-lg shadow-sm">
        <!-- Icon Placeholder -->
        <div class="mb-4">
          <svg
            class="w-12 h-12 mx-auto text-indigo-500"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
            ></path>
          </svg>
        </div>
        <h3 class="text-xl font-bold mb-2 text-gray-900">
          Increased Housing Costs
        </h3>
        <p class="text-gray-600">
          Required parking can increase the cost of a new home by over $100,000.
          In Boston, we've been permitting more new off-street parking (homes
          for cars) than housing units.
        </p>
      </div>

      <!-- Feature 2 -->
      <div class="flex-1 bg-gray-50 p-8 rounded-lg shadow-sm">
        <!-- Icon Placeholder -->
        <div class="mb-4">
          <svg
            class="w-12 h-12 mx-auto text-indigo-500"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15.362 5.214A8.252 8.252 0 0 1 12 21 8.25 8.25 0 0 1 6.038 7.047 8.287 8.287 0 0 0 9 9.601a8.983 8.983 0 0 1 3.361-6.867 8.21 8.21 0 0 0 3 2.48Z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 18a3.75 3.75 0 0 0 .495-7.468 5.99 5.99 0 0 0-1.925 3.547 5.975 5.975 0 0 1-2.133-1.001A3.75 3.75 0 0 0 12 18Z"
            ></path>
          </svg>
        </div>
        <h3 class="text-xl font-bold mb-2 text-gray-900">
          Negative Environmental Impacts
        </h3>
        <p class="text-gray-600">
          Vast parking lots trap heat, make stormwater flooding worse, and use
          up valuable space where we could have trees, parks, or more housing.
        </p>
      </div>

      <!-- Feature 3 -->
      <div class="flex-1 bg-gray-50 p-8 rounded-lg shadow-sm">
        <!-- Icon Placeholder -->
        <div class="mb-4">
          <svg
            class="w-12 h-12 mx-auto text-indigo-500"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.615A2.993 2.993 0 0 0 9.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 0 0 2.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 5.378 3h13.243a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72M6.75 18h3.75a.75.75 0 0 0 .75-.75V13.5a.75.75 0 0 0-.75-.75H6.75a.75.75 0 0 0-.75.75v3.75c0 .414.336.75.75.75Z"
            ></path>
          </svg>
        </div>
        <h3 class="text-xl font-bold mb-2 text-gray-900">
          Degraded Neighborhood Character
        </h3>
        <p class="text-gray-600">
          These rules make it impossible to build vibrant, walkable main
          streets. They make it hard to start or expand small businesses,
          hurting our neighborhood fabric.
        </p>
      </div>
    </div>

    <!-- Resources Section -->
    <div class="mt-20 pt-16 border-t border-gray-200">
      <h3 class="text-2xl md:text-3xl font-bold text-center mb-12">
        Learn More
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6">
        {
          resources.map((resource) => (
            <a
              href={resource.url}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-gray-50 hover:bg-gray-100 p-6 rounded-lg shadow-sm hover:shadow-md transition-all duration-200 hover:scale-105 cursor-pointer block"
            >
              <div class="mb-4">
                <div class="inline-block p-2 bg-indigo-100 rounded-lg">
                  <svg
                    class="w-6 h-6 text-indigo-600"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d={resource.iconPath}
                    />
                  </svg>
                </div>
                <span class="inline-block ml-3 text-xs font-semibold text-indigo-600 bg-indigo-50 px-2 py-1 rounded">
                  {resource.type === "article" && "Article"}
                  {resource.type === "video" && "Video"}
                  {resource.type === "book" && "Book"}
                  {resource.type === "website" && "Website"}
                </span>
              </div>
              <h4 class="text-lg font-bold text-gray-900 mb-2">
                {resource.title}
              </h4>
              <p class="text-gray-600 text-sm">{resource.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
